# production template: copy to .env on the server and fill every value.
# the server refuses to start while a required value is missing or weak.
NODE_ENV=production
APP_PORT=5000
# PostgreSQL (gaya Laravel)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=bloodsync
DB_USERNAME=bloodsync
DB_PASSWORD=GANTI_PASSWORD_DB
DB_SCHEMA=public
REDIS_URL="redis://localhost:6379"

# required, min 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# required: frontend origin(s), comma-separated; "*" is rejected
CORS_ORIGIN="https://bloodsync.example.id"
# reverse proxies in front of the app (nginx = 1, nginx behind cloudflare = 2)
TRUST_PROXY=1
# public https url, used in whatsapp links (tracker, emergency card)
PUBLIC_APP_URL="https://bloodsync.example.id"
UPLOAD_DIR="uploads"
ENGINE_INTERVAL_MS=5000

# whatsapp via fonnte.com (required): device token from the fonnte dashboard
FONNTE_TOKEN=""
# required, min 16 random chars. set the webhook of the fonnte device to:
#   PUBLIC_APP_URL/api/webhooks/whatsapp?secret=<this value>
WA_WEBHOOK_SECRET=""

# push notification via firebase cloud messaging (optional; empty = push off). see README "Push notification"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_API_KEY=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_VAPID_KEY=""

# cleanup job: days to keep activity logs, staff notifications and unused push tokens (medical records are never deleted)
AUDIT_RETENTION_DAYS=180
NOTIFICATION_RETENTION_DAYS=90
PUSH_TOKEN_RETENTION_DAYS=90
