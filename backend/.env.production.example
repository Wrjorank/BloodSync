# production template: copy to .env on the server and fill every value.
# the server refuses to start while a required value is missing or weak.
NODE_ENV=production
PORT=5000
DATABASE_URL="mysql://bloodsync:GANTI_PASSWORD_DB@localhost:3306/bloodsync"
REDIS_URL="redis://localhost:6379"

# required, min 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# required: frontend origin(s), comma-separated; "*" is rejected
CORS_ORIGIN="https://bloodsync.example.id"
# reverse proxies in front of the app (nginx = 1, nginx behind cloudflare = 2)
TRUST_PROXY=1
# public https url, used in whatsapp links (tracker, emergency card)
PUBLIC_APP_URL="https://bloodsync.example.id"
UPLOAD_DIR="uploads"
ENGINE_INTERVAL_MS=5000

# whatsapp via fonnte.com (required): device token from the fonnte dashboard
FONNTE_TOKEN=""
# required, min 16 random chars. set the webhook of the fonnte device to:
#   PUBLIC_APP_URL/api/webhooks/whatsapp?secret=<this value>
WA_WEBHOOK_SECRET=""
