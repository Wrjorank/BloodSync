NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://root:@localhost:3306/bloodsync"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="ganti-dengan-string-acak-panjang"
CORS_ORIGIN="*"
PUBLIC_APP_URL="http://localhost:5000"
UPLOAD_DIR="uploads"
ENGINE_INTERVAL_MS=5000
# development only: return OTP codes in the API response (no WhatsApp gateway needed)
EXPOSE_OTP=true
ENABLE_DEMO_ROUTES=true
