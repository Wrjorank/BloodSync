NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://root:@localhost:3306/bloodsync"
REDIS_URL="redis://localhost:6379"
# min 32 random chars in production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="ganti-dengan-string-acak-panjang"
# production: comma-separated frontend origins, "*" is rejected
CORS_ORIGIN="*"
# number of reverse proxies (nginx, cloudflare, ...) in front of the app; 0 when exposed directly
TRUST_PROXY=0
PUBLIC_APP_URL="http://localhost:5000"
UPLOAD_DIR="uploads"
ENGINE_INTERVAL_MS=5000
ENABLE_DEMO_ROUTES=true
# swagger ui at /docs (openapi json at /docs/openapi.json). default: on in development, off in production
ENABLE_API_DOCS=true
# whatsapp via fonnte.com, required in production (see .env.production.example).
# empty in development = every whatsapp message (otp included) pops up as an on-screen notification in local browsers
FONNTE_TOKEN=""
# random string; webhook url in fonnte = PUBLIC_APP_URL/api/webhooks/whatsapp?secret=<this>
WA_WEBHOOK_SECRET=""
# population registry: people who never signed up are called too. local = residents table (dummy seed),
# external = api of an institution holding population data (dukcapil, bpjs, ...), contract in population.service.ts
POPULATION_SOURCE="local"
POPULATION_API_URL=""
POPULATION_API_KEY=""
# false = only donors who signed up in the app are called
ENABLE_REGISTRY="true"
# optional real phone added to the dummy registry by the seed, for live whatsapp demos
DEMO_RESIDENT_PHONE=""
