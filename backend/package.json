{
  "name": "bloodsync-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch-path=src -r ts-node/register src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node scripts/prisma-runner.js generate",
    "db:migrate": "node scripts/prisma-runner.js migrate deploy",
    "db:migrate:dev": "node scripts/prisma-runner.js migrate dev",
    "db:seed": "node scripts/prisma-runner.js db seed",
    "db:reset": "node scripts/prisma-runner.js migrate reset --force",
    "setup": "npm run prisma:generate && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "fflate": "^0.8.3",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^5.0.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.5.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.0.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
