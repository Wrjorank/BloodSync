APP_PORT=5000

# Konfigurasi Database PostgreSQL (gaya Laravel)
DB_CONNECTION=pgsql
# Gunakan host.docker.internal bila menjalankan app via Docker dan PostgreSQL di host machine
# Gunakan 127.0.0.1 bila menjalankan langsung tanpa docker (npm run dev)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=bloodsync
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# token device dari dashboard fonnte.com. diisi = OTP, undangan donor, dan kabar keluarga dikirim ke WhatsApp asli
FONNTE_TOKEN=

# untuk balasan "1"/"2" pendonor lewat WhatsApp. string acak min 16 karakter, contoh:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# webhook di fonnte: <PUBLIC_APP_URL>/api/webhooks/whatsapp?secret=<nilai ini>
WA_WEBHOOK_SECRET=

# alamat publik (url tunnel, domain, atau Tailnet) yang muncul di link pesan WhatsApp dan dipakai webhook fonnte
PUBLIC_APP_URL=http://localhost:5000

# ---------- server publik (staging / production) ----------
# kosongkan di lokal. di server yang bisa diakses internet WAJIB diisi:
# NODE_ENV=production
# JWT_SECRET=          # acak min 32 karakter: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# CORS_ORIGIN=https://bloodsync.delcom.org
# ENABLE_DEMO_ROUTES=false
# ENABLE_API_DOCS=false
# DEV_INBOX_TRUST_NETWORK=false

# 1 bila diakses lewat tunnel/reverse proxy (cloudflared, ngrok, nginx), 0 bila langsung
TRUST_PROXY=0

# nomor WA asli untuk demo lomba: dimasukkan ke data penduduk dummy (dekat RSUD Tarakan, golongan O+),
# jadi nomor ini ikut dipanggil Dispatch Engine tanpa pernah daftar akun. butuh FONNTE_TOKEN agar sampai ke HP
DEMO_RESIDENT_PHONE=
DEMO_RESIDENT_NAME=
DEMO_RESIDENT_BLOOD=

# push notification lewat Firebase Cloud Messaging (opsional; kosong = push dimatikan, WhatsApp + realtime tetap jalan)
# Project settings > Service accounts > Generate new private key: ambil project_id, client_email, private_key dari file JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# satu baris, ganti baris baru dengan 
 dan bungkus tanda kutip: "-----BEGIN PRIVATE KEY-----
MIIE...
-----END PRIVATE KEY-----
"
FIREBASE_PRIVATE_KEY=
# Project settings > General > Your apps > Web app (config firebaseConfig)
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web Push certificates > Key pair
FIREBASE_VAPID_KEY=
