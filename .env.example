# salin ke .env (di folder yang sama dengan docker-compose.yml), lalu: docker compose up -d
# semua kosong = mode lokal: pesan WhatsApp & OTP tampil sebagai notifikasi di browser

# token device dari dashboard fonnte.com. diisi = OTP, undangan donor, dan kabar keluarga dikirim ke WhatsApp asli
FONNTE_TOKEN=

# untuk balasan "1"/"2" pendonor lewat WhatsApp. string acak min 16 karakter, contoh:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# webhook di fonnte: <PUBLIC_APP_URL>/api/webhooks/whatsapp?secret=<nilai ini>
WA_WEBHOOK_SECRET=

# alamat publik (url tunnel atau domain) yang muncul di link pesan WhatsApp dan dipakai webhook fonnte
PUBLIC_APP_URL=http://localhost:5000

# 1 bila diakses lewat tunnel/reverse proxy (cloudflared, ngrok, nginx), 0 bila langsung
TRUST_PROXY=0
