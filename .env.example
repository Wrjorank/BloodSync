APP_PORT=5000

# Konfigurasi Database PostgreSQL (gaya Laravel)
DB_CONNECTION=pgsql
# Gunakan host.docker.internal bila menjalankan app via Docker dan PostgreSQL di host machine
# Gunakan 127.0.0.1 bila menjalankan langsung tanpa docker (npm run dev)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=bloodsync
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# token device dari dashboard fonnte.com. diisi = OTP, undangan donor, dan kabar keluarga dikirim ke WhatsApp asli
FONNTE_TOKEN=

# untuk balasan "1"/"2" pendonor lewat WhatsApp. string acak min 16 karakter, contoh:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# webhook di fonnte: <PUBLIC_APP_URL>/api/webhooks/whatsapp?secret=<nilai ini>
WA_WEBHOOK_SECRET=

# alamat publik (url tunnel, domain, atau Tailnet) yang muncul di link pesan WhatsApp dan dipakai webhook fonnte
# contoh Tailscale: PUBLIC_APP_URL=http://iky-1.ts.net:5000
# contoh IP Tailnet: PUBLIC_APP_URL=http://100.85.156.42:5000
PUBLIC_APP_URL=http://localhost:5000

# 1 bila diakses lewat tunnel/reverse proxy (cloudflared, ngrok, nginx), 0 bila langsung
TRUST_PROXY=0

# nomor WA asli untuk demo lomba: dimasukkan ke data penduduk dummy (dekat RSUD Tarakan, golongan O+),
# jadi nomor ini ikut dipanggil Dispatch Engine tanpa pernah daftar akun. butuh FONNTE_TOKEN agar sampai ke HP
DEMO_RESIDENT_PHONE=
DEMO_RESIDENT_NAME=
DEMO_RESIDENT_BLOOD=
